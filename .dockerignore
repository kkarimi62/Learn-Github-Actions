# Git metadata and GitHub configuration
.git
.github
.gitignore

# Python bytecode and caches
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local virtual environments
.venv/
venv/
env/

# Local environment files (keep example templates)
.env
.env.*
!.env.example
!.env.sample

# Build and packaging artifacts
build/
dist/
**/*.egg-info/

# Test coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml

# Editor and operating system files
.vscode/
.idea/
**/.DS_Store
**/Thumbs.db

# Local logs
**/*.log
